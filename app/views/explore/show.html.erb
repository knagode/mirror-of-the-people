<div class="hero" data-controller="loading-form">
  <h1>Kaj si ljudje želijo?</h1>
  <p class="subtitle">Vprašaj karkoli — umetna inteligenca bo poiskala relevantne želje državljanov in povzela njihova mnenja.</p>

  <%= form_with url: explore_search_path, method: :post, class: "wish-form", data: { turbo: false, action: "submit->loading-form#submit" } do |f| %>
    <%= f.text_field :question, value: @question, placeholder: "Kaj si ljudje mislijo o zdravstvu?", class: "wish-input", required: true, autofocus: true %>
    <%= f.submit "Razišči in pripravi povzetek", class: "btn", data: { loading_form_target: "submit" } %>
  <% end %>

  <div class="loading hidden" data-loading-form-target="spinner">
    <div class="spinner"></div>
    <p>Iščem relevantne želje in pripravljam povzetek...</p>
  </div>
</div>

<% if @recent_queries.any? && @answer.blank? %>
  <div class="explore-recent">
    <h2>Zadnja vprašanja</h2>
    <div class="explore-queries-list">
      <% @recent_queries.each do |query| %>
        <%= link_to explore_query_path(query), class: "explore-query-card" do %>
          <p class="explore-query-question"><%= query.question %></p>
          <span class="explore-query-meta"><%= time_ago_in_words(query.created_at) %> nazaj · <%= query.wishes_count %> želj</span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @answer.present? %>
  <div class="explore-results">
    <div class="explore-answer">
      <h2>Povzetek mnenj</h2>
      <div class="explore-answer-content">
        <%= @answer.html_safe %>
      </div>
    </div>

    <% if @wishes.any? %>
      <div class="explore-wishes">
        <h2>Relevantne želje (<%= @wishes.size %>)</h2>
        <div class="recent-wishes">
          <% @wishes.each do |wish| %>
            <div class="similar-wish-wrapper">
              <% similarity = ((1 - wish.neighbor_distance) * 100).round %>
              <span class="similarity-badge"><%= similarity %>%</span>
              <%= render "wishes/wish", wish: wish %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
