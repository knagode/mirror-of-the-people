<div class="tag-page">
  <h1><%= @tag.name.humanize %></h1>
  <% if @tag.category.present? %>
    <p class="subtitle"><%= @tag.category %></p>
  <% end %>

  <% if @related_articles.any? %>
    <div class="related-articles">
      <h2>Povezani članki</h2>
      <% @related_articles.each do |article| %>
        <%= link_to article_path(article), class: "article-preview" do %>
          <h3><%= article.title %></h3>
          <p class="article-excerpt"><%= truncate(article.content, length: 200) %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <p class="subtitle"><%= @wishes.count %> <%= @wishes.count == 1 ? "želja" : "želj" %> s to oznako</p>

  <div class="recent-wishes">
    <% @wishes.each do |wish| %>
      <%= render "wishes/wish", wish: wish %>
    <% end %>
  </div>
</div>
