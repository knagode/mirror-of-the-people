<div class="recent-wish-row">
  <%= render "wishes/vote_buttons", wish: wish %>
  <div class="recent-wish">
    <p><%= truncate(wish.content, length: 120) %></p>
    <div class="wish-meta">
      <span class="time"><%= time_ago_in_words(wish.created_at) %> nazaj</span>
      <%= link_to wish_path(wish, anchor: "comments"), class: "comment-count" do %><%= wish.comments.size %> <%= wish.comments.size == 1 ? "komentar" : "komentarjev" %><% end %>
      <% if wish.tag_list.any? %>
        <% wish.tag_list.each do |tag| %>
          <%= link_to "##{tag}", tag_path(tag), class: "tag" %>
        <% end %>
      <% end %>
      <%= link_to "Več →", wish_path(wish), class: "wish-more" %>
      <% if user_signed_in? && current_profile && wish.profile_id == current_profile.id %>
        <%= link_to "Odveži", disown_wish_path(wish), data: { turbo_method: :delete, turbo_confirm: "Želja bo ostala, a ne bo več povezana s tvojim profilom." }, class: "wish-delete" %>
        <%= link_to "Izbriši", wish_path(wish), data: { turbo_method: :delete, turbo_confirm: "Ali res želite izbrisati to željo?" }, class: "wish-delete" %>
      <% end %>
    </div>
  </div>
</div>
