<div class="results">
  <div class="wish-card">
    <div class="wish-card-inner">
      <%= render "vote_buttons", wish: @wish %>
      <div>
        <h2>Želim si ...</h2>
        <p class="wish-content"><%= @wish.content %></p>
        <% if @wish.tag_list.any? %>
          <div class="wish-tags">
            <% @wish.tag_list.each do |tag| %>
              <%= link_to "##{tag}", tag_path(tag), class: "tag" %>
            <% end %>
          </div>
        <% end %>
        <%# TODO: omogoči ko bo registracija aktivna %>
        <%# if user_signed_in? && current_profile && @wish.profile_id == current_profile.id %>
        <%#   link_to "Odveži od profila", disown_wish_path(@wish), ... %>
        <%#   link_to "Izbriši željo", wish_path(@wish), ... %>
        <%# end %>
      </div>
    </div>
  </div>

  <%= turbo_frame_tag "matches", src: matches_wish_path(@wish), loading: :eager do %>
    <div class="loading">
      <div class="spinner"></div>
      <p>Umetna inteligenca analizira tvojo željo in jo primerja s programi strank...</p>
    </div>
  <% end %>

  <%# <% if @related_articles.any? %>
  <%#   <div class="related-articles"> %>
  <%#     <h2>Povezani članki</h2> %>
  <%#     <% @related_articles.each do |article| %> %>
  <%#       <%= link_to article_path(article), class: "article-preview" do %> %>
  <%#         <h3><%= article.title %></h3> %>
  <%#         <p class="article-excerpt"><%= truncate(article.content, length: 200) %></p> %>
  <%#       <% end %> %>
  <%#     <% end %> %>
  <%#   </div> %>
  <%# <% end %> %>

  <% if @similar_wishes.any? %>
    <div class="similar-wishes">
      <h2>Podobne želje</h2>
      <div class="recent-wishes">
        <% @similar_wishes.each do |wish| %>
          <div class="similar-wish-wrapper">
            <% similarity = ((1 - wish.neighbor_distance) * 100).round %>
            <span class="similarity-badge"><%= similarity %>% podobnost</span>
            <%= render "wish", wish: wish %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div id="comments" class="comments-section">
    <h2>Komentarji (<%= @wish.comments.count %>)</h2>

    <%= form_with url: wish_comments_path(@wish), method: :post, class: "comment-form" do |f| %>
      <%= f.text_area :content, placeholder: "Napiši komentar...", rows: 3, class: "comment-input", required: true, name: "comment[content]" %>
      <%= f.submit "Komentiraj", class: "btn btn-small" %>
    <% end %>

    <div class="comments-list">
      <% @wish.comments.order(created_at: :desc).each do |comment| %>
        <div class="comment-card">
          <p class="comment-content"><%= comment.content %></p>
          <span class="comment-time"><%= time_ago_in_words(comment.created_at) %> nazaj</span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="actions">
    <%= link_to "Nova želja", root_path, class: "btn" %>
  </div>
</div>
