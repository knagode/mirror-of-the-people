<div class="stats">
  <h1>Statistika in kaj si ljudje želijo?</h1>
  <p class="subtitle">Skupaj je bilo podanih <strong><%= @total_wishes %></strong> želj.</p>

  <% if @ai_summary %>
    <div class="ai-summary-box">
      <h2>Povzetek želja</h2>
      <div class="ai-summary-content"><%= sanitize(@ai_summary.content, tags: %w[p strong]) %></div>
    </div>

    <% if @ai_summary.recommendations.present? %>
      <div class="ai-summary-box ai-recommendations">
        <h2>10 priporočil za državo</h2>
        <div class="ai-summary-content"><%= sanitize(@ai_summary.recommendations, tags: %w[p strong ol li]) %></div>
      </div>
    <% end %>

    <% if @ai_summary.party_matches.present? %>
      <div class="ai-summary-box ai-party-matches">
        <h2>Ujemanje strank s priporočili</h2>
        <div class="ai-summary-content"><%= sanitize(@ai_summary.party_matches, tags: %w[p strong ol li]) %></div>
      </div>
    <% end %>

    <p class="ai-summary-meta">Povzetek je samodejno generiran z umetno inteligenco na podlagi <%= @ai_summary.wishes_count %> želj. Zadnja posodobitev: <%= @ai_summary.created_at.strftime("%-d.%-m.%Y") %>.</p>
  <% end %>

  <h2>Povprečno ujemanje strank</h2>
  <div class="stats-cards">
    <% @parties.each do |data| %>
      <div class="stat-card">
        <h3><%= data[:party].name %></h3>
        <div class="stat-score <%= score_class(data[:avg_score]) %>">
          <%= data[:avg_score] %>%
        </div>
        <p class="stat-detail"><%= data[:match_count] %> ujemanj</p>
      </div>
    <% end %>
  </div>

  <h2>Zadnje želje ljudi</h2>
  <div class="recent-wishes">
    <% @recent_wishes.each do |wish| %>
      <%= render "wishes/wish", wish: wish %>
    <% end %>
  </div>

  <% if @tags.any? %>
    <h2>Teme</h2>
    <div class="tag-cloud">
      <% max_count = @tags.map(&:wish_count).max.to_f %>
      <% @tags.each do |tag| %>
        <% size = 0.75 + (tag.wish_count / max_count) * 1.25 %>
        <%= link_to "##{tag.name}", tag_path(tag.name), class: "tag-cloud-item", style: "font-size: #{size}rem" %>
      <% end %>
    </div>
  <% end %>
</div>
